{
	"engines": {
		"node": ">=24.22.1",
		"npm": ">=11.18.0"
	},
	"volta": {
		"node": "24.22.1"
	},
	"author": "inc2734",
	"license": "GPL-2.0+",
	"dependencies": {
		"postcss": "^8.5.26",
		"sass-basis": "^20.0.1"
	},
	"devDependencies": {
		"@wordpress/browserslist-config": "^7.0.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/scripts": "^37.0.0",
		"autoprefixer": "^10.5.4",
		"cpy-cli": "^7.0.0",
		"cssnano": "^8.0.6",
		"jsdom": "^30.1.3",
		"npm-run-all": "^4.1.5",
		"postcss-cli": "^11.0.1",
		"rimraf": "^6.1.3",
		"run-sequence": "^2.2.1",
		"sass": "^1.102.0"
	},
	"scripts": {
		"export:wp-content:themes": "npm run cli cp -- -r ../../themes .export/wp-content",
		"export:wp-content:uploads": "npm run cli cp -- -r ../../uploads .export/wp-content",
		"export:wp-content": "npm run cli rm -- -rf .export/wp-content && mkdir -p .export/wp-content/uploads && run-p export:wp-content:*",
		"export:db": "mkdir -p .export/sql && npm run wp db -- export .export/sql/local.sql",
		"export": "run-p export:*",
		"import:wp-content:themes": "npm run cli cp -- -r .export/wp-content/themes ../../",
		"import:wp-content:uploads": "npm run cli cp -- -r .export/wp-content/uploads ../../",
		"import:wp-content": "run-p import:wp-content:*",
		"import:db": "npm run wp db -- import .export/sql/local.sql",
		"import": "run-p import:*",
		"wp-env": "wp-env",
		"start": "wp-env start && open http://localhost:8888",
		"stop": "npm run export && wp-env stop",
		"destroy": "wp-env destroy && wp-env destroy --config=.wp-env.tests.json",
		"cli": "wp-env run cli --env-cwd=\"wp-content/plugins/snow-monkey-bbpress-support\"",
		"wp": "npm run cli -- wp",
		"composer": "wp-env run --env-cwd=\"wp-content/plugins/snow-monkey-bbpress-support\" cli composer",
		"test:php:start": "wp-env start --config=.wp-env.tests.json",
		"test:php:stop": "wp-env stop --config=.wp-env.tests.json",
		"test-composer": "wp-env run --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/snow-monkey-bbpress-support\" cli composer",
		"pretest:php:lint": "npm run test:php:start && npm run test-composer install -- --no-interaction",
		"test:php:lint": "npm run test-composer lint",
		"posttest:php:lint": "npm run test:php:stop",
		"test:lint:php": "npm run test:php:lint || (status=$?; npm run test:php:stop; exit $status)",
		"test:lint": "run-s test:lint:*",
		"pretest:php:unit": "npm run test:php:start && npm run test-composer install -- --no-interaction && npm run test-composer install-theme && npm run test-composer install-plugin",
		"test:php:unit": "wp-env run --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/snow-monkey-bbpress-support\" wordpress vendor/bin/phpunit -c .phpunit.xml.dist --verbose",
		"posttest:php:unit": "npm run test:php:stop",
		"test:unit:php": "npm run test:php:unit || (status=$?; npm run test:php:stop; exit $status)",
		"test:unit": "run-s test:unit:*",
		"test": "run-s test:lint test:unit",
		"clean:css": "rimraf assets/css && mkdir -p assets/css",
		"clean:js": "rimraf assets/js && mkdir -p assets/js",
		"clean:zip": "rimraf snow-monkey-bbpress-support.zip",
		"css:bbpress": "sass --no-source-map src/css/bbpress.scss:assets/css/bbpress.css && postcss assets/css/bbpress.css -r -c=postcss.config.js",
		"css": "npm run clean:css && npm-run-all -p css:*",
		"js:app": "wp-scripts build src/js/app.js --output-path=assets/js",
		"js": "npm run clean:js && npm-run-all -p js:*",
		"build": "npm-run-all -p css js",
		"make-pot": "wp-env start && npm run wp i18n -- make-pot . ./languages/snow-monkey-bbpress-support.pot -- --exclude=.*,src",
		"make-php": "npm run cli php -- ./bin/l10n.php",
		"zip:pack": "rsync -a --exclude='/vendor' --exclude='/node_modules' --exclude='.*' --exclude='*.ruleset.xml' --exclude='*.config.js' --exclude='*.xml.dist' --exclude='/bin' --exclude='/tests' --exclude='package*.json' . snow-monkey-bbpress-support && wp-env start && npm run composer install -- --no-interaction --no-dev -d snow-monkey-bbpress-support",
		"zip:archive": "zip -9 -qmr snow-monkey-bbpress-support.zip snow-monkey-bbpress-support",
		"zip": "npm run clean:zip && npm run zip:pack && npm run zip:archive",
		"pretest:unit:js": "npm run js",
		"test:unit:js": "node --test tests/js/*.test.cjs"
	}
}
